[Unit]
Description=LED Checklist WebSocket Sync Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/admin/web/static.93.189.179.185.ip.webhost1.net/public_html
EnvironmentFile=/etc/default/led-checklist-ws
ExecStart=/usr/bin/python3 /home/admin/web/static.93.189.179.185.ip.webhost1.net/public_html/checklist_ws_server.py --host ${HOST} --port ${PORT} --project-store-url ${PROJECT_STORE_URL} --save-debounce-ms ${SAVE_DEBOUNCE_MS} --certfile ${CERTFILE} --keyfile ${KEYFILE}
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
