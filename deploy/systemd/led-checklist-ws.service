[Unit]
Description=LED Checklist WebSocket Sync Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/web/static.93.189.179.185.ip.webhost1.net/public_html
EnvironmentFile=/etc/default/led-checklist-ws
ExecStart=/usr/bin/python3 /home/admin/web/static.93.189.179.185.ip.webhost1.net/public_html/checklist_ws_server.py --host ${WS_HOST} --port ${WS_PORT} --project-store-url ${PROJECT_STORE_URL} --save-debounce-ms ${SAVE_DEBOUNCE_MS}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
